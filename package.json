{
  "name": "botwarren-companion",
  "version": "0.1.2",
  "private": true,
  "description": "Botwarren Companion: opt-in, end-to-end encrypted remote approvals for your coding agents (the companion, the relay and the signed web client).",
  "license": "Apache-2.0",
  "homepage": "https://botwarren.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/turbokast/botwarren-companion.git"
  },
  "bugs": {
    "email": "support@turbokast.com"
  },
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:e2e": "pnpm --filter @botwarren/companion test:e2e",
    "build:client": "pnpm --filter @botwarren/companion build:client",
    "build:component": "node --disable-warning=ExperimentalWarning apps/companion/scripts/build-component.mjs"
  }
}
